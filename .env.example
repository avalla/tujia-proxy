# Tujia's mobile web host. The reverse-engineered endpoints live here.
TUJIA_API_URL=https://m.tujia.com

PORT=3000
CACHE_TTL_SECONDS=300

# NOTE: there is no bearer token. Tujia authenticates the H5 endpoints with a browser
# session, which is hardcoded as COOKIES in src/services/tujiaClient.ts and has to be
# re-sniffed from DevTools when it expires. See README "Keeping it working".
